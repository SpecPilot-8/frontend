{
  "name": "extension",
  "displayName": "extension",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.136.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:specpilot.openDashboard",
    "onCommand:specpilot.restoreSnapshot",
    "onCommand:specpilot.testJumpToLocation"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "specpilot.openDashboard",
        "title": "SpecPilot: Open Dashboard"
      },
      {
        "command": "specpilot.restoreSnapshot",
        "title": "SpecPilot: Restore Snapshot Folder"
      },
      {
        "command": "specpilot.testJumpToLocation",
        "title": "SpecPilot: Test Jump To Location"
      }
    ],
    "configuration": {
      "title": "SpecPilot",
      "properties": {
        "specpilot.workspaceRoot": {
          "type": "string",
          "default": "C:\\",
          "description": "분석한 소스를 복원할 상위 폴더입니다. 프로젝트마다 이 아래에 프로젝트명으로 폴더를 만듭니다."
        },
        "specpilot.apiBaseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8000/api/v2",
          "description": "SpecPilot 백엔드 API 주소입니다."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.137.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
